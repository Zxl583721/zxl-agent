LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Retrieval reranker. Default keeps the fast local implementation.
RERANKER_PROVIDER=lightweight
RERANKER_FALLBACK=lightweight
# Set RERANKER_PROVIDER=bge to use the evaluated BAAI/bge-reranker-v2-m3 model.
# BGE_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
# BGE_RERANKER_USE_FP16=false
# BGE_RERANKER_BATCH_SIZE=8
# BGE requires the optional FlagEmbedding/torch dependencies and a local model directory.

# MySQL persistence.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zxl_agent
MYSQL_PASSWORD=change_me_strong_password
MYSQL_DATABASE=zxl_agent
DATABASE_ECHO=false

JWT_SECRET_KEY=change_me_to_a_32_plus_char_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=20971520

# Redis cache, rate limiting, and task status cache.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_or_leave_empty_for_local_only
REDIS_SOCKET_TIMEOUT=1.0
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_CACHE_TTL_SECONDS=300
TASK_STATUS_CACHE_TTL_SECONDS=86400

# Celery async document indexing. Defaults reuse Redis config above.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# 如需切回智谱，可改为：
# LLM_PROVIDER=zhipu
# EMBEDDING_PROVIDER=zhipu
# ZHIPUAI_API_KEY=your_api_key_here

# 如需使用 DeepSeek 生成回答，同时保留本地 Ollama embedding，可改为：
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# EMBEDDING_PROVIDER=ollama
