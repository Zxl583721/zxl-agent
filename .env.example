LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# MySQL persistence.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zxl_agent
MYSQL_PASSWORD=zxl_agent
MYSQL_DATABASE=zxl_agent
DATABASE_ECHO=false

# Temporary defaults before auth and multi-tenant knowledge bases are added.
DEFAULT_USER_ID=1
DEFAULT_KNOWLEDGE_BASE_ID=1

# Redis cache, rate limiting, and task status cache.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=1.0
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_CACHE_TTL_SECONDS=300
TASK_STATUS_CACHE_TTL_SECONDS=86400

# Celery async document indexing. Defaults reuse Redis config above.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# 如需切回智谱，可改为：
# LLM_PROVIDER=zhipu
# EMBEDDING_PROVIDER=zhipu
# ZHIPUAI_API_KEY=your_api_key_here
